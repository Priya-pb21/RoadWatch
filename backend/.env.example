MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=road_pothole_db
POTHOLES_COLLECTION=potholes
DETECTIONS_COLLECTION=detection_events
EVENTS_COLLECTION=system_events
USERS_COLLECTION=users
AUTH_TOKENS_COLLECTION=auth_tokens
AUTH_RATE_LIMITS_COLLECTION=auth_rate_limits
REPORT_SCHEDULES_COLLECTION=report_schedules
REPORT_RUNS_COLLECTION=report_runs
ROADWATCH_JWT_SECRET=<generate-a-random-secret-at-least-32-bytes>
ROADWATCH_JWT_EXPIRE_MINUTES=720
ROADWATCH_COOKIE_SECURE=false
ROADWATCH_INITIAL_ADMIN_SETUP_SECRET=<generate-a-private-random-secret-at-least-32-bytes>
ROADWATCH_MODEL_PATH=../runs/pothole_yolo11n/weights/best.pt
ROADWATCH_CONFIDENCE_THRESHOLD=0.25
ROADWATCH_GPS_ACCURACY_THRESHOLD_M=100
ROADWATCH_PUBLIC_BASE_URL=http://localhost:5173
ROADWATCH_EMAIL_SMTP_HOST=
ROADWATCH_EMAIL_SMTP_PORT=587
ROADWATCH_EMAIL_SMTP_USERNAME=
ROADWATCH_EMAIL_SMTP_PASSWORD=
ROADWATCH_EMAIL_FROM=
ROADWATCH_EMAIL_STARTTLS=true
ROADWATCH_EMAIL_USE_SSL=false
ROADWATCH_EMAIL_TIMEOUT_SECONDS=10
ROADWATCH_EMAIL_VERIFICATION_TTL_MINUTES=1440
ROADWATCH_PASSWORD_RESET_TTL_MINUTES=30
ROADWATCH_REPORTS_DIRECTORY=
ROADWATCH_REPORT_RETENTION_DAYS=30
